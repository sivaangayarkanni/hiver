# Copy to .env (gitignored) for local development.

# Postgres connection string. Any Postgres works (local, Supabase, Neon, Render, Railway).
# On Vercel the Supabase/Neon integration sets POSTGRES_URL automatically; DATABASE_URL wins if both are set.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiver
# POSTGRES_URL=

# Apply migrations + seed demo data automatically on first request (default: 1).
HIVER_AUTO_MIGRATE=1
HIVER_AUTO_SEED=1
# Password for the seeded demo accounts (default: hiver-demo-2026).
HIVER_DEMO_PASSWORD=

# Session lifetime in days (default: 14).
SESSION_DAYS=14

# Optional live LLM drafting (omit for the deterministic dry-run drafter).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
